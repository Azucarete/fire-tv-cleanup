<?xml version="1.0" encoding="utf-8"?>
<!-- "Now playing": the song another app (Spotify) is playing, under the home screen's clock and in the screensaver.
     Filled and shown by NowPlaying while something plays. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="10dp"
    android:paddingEnd="22dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:alpha="0"
    android:visibility="gone">

    <ImageView
        android:id="@+id/npArt"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#26FFFFFF"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/npLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/now_playing"
            android:textAllCaps="true"
            android:letterSpacing="0.18"
            android:textColor="#8CFFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/open_sans"
            android:fontVariationSettings="'wght' 600" />

        <TextView
            android:id="@+id/npTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="320dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/open_sans"
            android:fontVariationSettings="'wght' 650" />

        <TextView
            android:id="@+id/npArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/open_sans"
            android:fontVariationSettings="'wght' 450" />
    </LinearLayout>
</LinearLayout>
